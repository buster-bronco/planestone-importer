<section class="npc-importer">
  {{#if isEdit}}
    <div class="body">
      <p class="hint">{{hint}}</p>
      <textarea name="patchText" class="paste" spellcheck="false" placeholder="{{placeholder}}" {{#if busy}}disabled{{/if}}>{{text}}</textarea>
    </div>
    <footer class="buttons">
      <button type="button" data-action="copySheet" data-tooltip="{{localize "planestone-importer.patch.copySheetHint"}}"><i class="fa-solid fa-copy"></i> {{localize "planestone-importer.patch.copySheet"}}</button>
      <label class="button file-button">
        <i class="fa-solid fa-file-arrow-up"></i> {{localize "planestone-importer.patch.fromFile"}}
        <input type="file" accept=".yaml,.yml,.json" {{#if busy}}disabled{{/if}}>
      </label>
      <button type="button" data-action="preview" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-eye"></i> {{#if busy}}{{localize "planestone-importer.dialog.reading"}}{{else}}{{localize "planestone-importer.patch.preview"}}{{/if}}</button>
    </footer>
  {{/if}}

  {{#if isPreview}}
    <div class="body">
      {{#if errors.length}}
        <div class="messages errors">
          <h4>{{localize "planestone-importer.patch.errors"}}</h4>
          <ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
        </div>
      {{/if}}

      {{#if changes.length}}
        <div class="patches">
          <h4>{{localize "planestone-importer.patch.changes"}}</h4>
          <ul>{{#each changes}}<li>{{this}}</li>{{/each}}</ul>
        </div>
      {{/if}}

      {{#if warnings.length}}
        <div class="messages warnings">
          <h4>{{localize "planestone-importer.dialog.warnings"}}</h4>
          <ul>{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
        </div>
      {{/if}}
    </div>
    <footer class="buttons">
      <button type="button" data-action="back"><i class="fa-solid fa-rotate-left"></i> {{localize "planestone-importer.dialog.back"}}</button>
      <button type="button" data-action="apply" {{#unless canApply}}disabled{{/unless}}><i class="fa-solid fa-file-pen"></i> {{#if busy}}{{localize "planestone-importer.patch.applying"}}{{else}}{{localize "planestone-importer.patch.apply"}}{{/if}}</button>
    </footer>
  {{/if}}

  {{#if isDone}}
    <div class="body">
      <ul class="results">
        <li class="{{#if result.ok}}ok{{else}}failed{{/if}}">
          {{#if result.ok}}<i class="fa-solid fa-check"></i> {{localize "planestone-importer.patch.applied"}}{{else}}<i class="fa-solid fa-xmark"></i> {{result.error}}{{/if}}
        </li>
      </ul>
    </div>
    <footer class="buttons">
      <button type="button" data-action="back"><i class="fa-solid fa-file-pen"></i> {{localize "planestone-importer.patch.another"}}</button>
    </footer>
  {{/if}}
</section>
