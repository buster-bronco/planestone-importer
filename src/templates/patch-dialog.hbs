<section class="npc-importer">
  {{#if isEdit}}
    <div class="body">
      <p class="hint">{{hint}}</p>
      <textarea name="patchText" class="paste" spellcheck="false" placeholder="{{placeholder}}" {{#if busy}}disabled{{/if}}>{{text}}</textarea>
    </div>
    <footer class="buttons">
      <button type="button" data-action="copySheet" data-tooltip="{{localize "planestone-importer.patch.copySheetHint"}}"><i class="fa-solid fa-copy"></i> {{localize "planestone-importer.patch.copySheet"}}</button>
      <label class="button file-button">
        <i class="fa-solid fa-file-arrow-up"></i> {{localize "planestone-importer.patch.fromFile"}}
        <input type="file" accept=".yaml,.yml,.json" {{#if busy}}disabled{{/if}}>
      </label>
      {{#if aiEnabled}}
        <button type="button" data-action="prompt" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "planestone-importer.ai.promptPatch"}}</button>
      {{/if}}
      <button type="button" data-action="preview" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-eye"></i> {{#if busy}}{{localize "planestone-importer.dialog.reading"}}{{else}}{{localize "planestone-importer.patch.preview"}}{{/if}}</button>
    </footer>
  {{/if}}

  {{#if isPrompt}}
    <div class="body">
      <p class="hint">{{localize "planestone-importer.ai.patchHint"}}</p>
      {{#if aiError}}
        <div class="messages errors"><ul><li>{{aiError}}</li></ul></div>
      {{/if}}
      <textarea name="request" class="paste prose" placeholder="{{localize "planestone-importer.ai.patchPlaceholder"}}" {{#if busy}}disabled{{/if}}>{{request}}</textarea>
    </div>
    <footer class="buttons">
      <button type="button" data-action="back" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-rotate-left"></i> {{localize "planestone-importer.dialog.back"}}</button>
      <button type="button" data-action="send" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-paper-plane"></i> {{#if busy}}{{localize "planestone-importer.ai.thinking"}}{{else}}{{localize "planestone-importer.ai.send"}}{{/if}}</button>
    </footer>
  {{/if}}

  {{#if showPlan}}
    <div class="body">
      {{#if isReview}}
        {{#if aiError}}
          <div class="messages errors"><ul><li>{{aiError}}</li></ul></div>
        {{/if}}
        {{#if notes}}<p class="ai-notes">{{notes}}</p>{{/if}}
        {{#if hunks.length}}
          <div class="hunks">
            <h4>{{localize "planestone-importer.ai.hunks"}}</h4>
            {{#each hunks}}
              <label class="hunk {{#unless checked}}rejected{{/unless}}">
                <input type="checkbox" data-hunk="{{id}}" {{#if checked}}checked{{/if}} {{#if ../busy}}disabled{{/if}}>
                <span>{{label}}{{#each errors}}<small class="hunk-error">{{this}}</small>{{/each}}</span>
              </label>
            {{/each}}
          </div>
        {{/if}}
      {{/if}}

      <div class="hunks text-fixes">
        <label class="hunk lint-toggle" data-tooltip="{{localize "planestone-importer.review.lintHint"}}">
          <input type="checkbox" data-lint {{#if review.lint}}checked{{/if}} {{#if busy}}disabled{{/if}}>
          <span>{{localize "planestone-importer.review.lint"}}</span>
        </label>
        {{#if review.fixes.length}}
          <h4>{{localize "planestone-importer.review.fixes"}}</h4>
          {{#each review.fixes}}
            <label class="hunk {{#unless checked}}rejected{{/unless}}">
              <input type="checkbox" data-fix="{{id}}" {{#if checked}}checked{{/if}} {{#if ../busy}}disabled{{/if}}>
              <span><small class="fix-kind">{{kind}}</small> {{label}}</span>
            </label>
          {{/each}}
        {{/if}}
        {{#if review.suggestions.length}}
          <h4>{{localize "planestone-importer.review.suggestions"}}</h4>
          {{#each review.suggestions}}
            <div class="suggestion">
              <span>{{where}}</span>
              {{#each candidates}}
                {{#if ../../review.canPick}}
                  <button type="button" data-pick="{{name}}" data-name="{{../name}}" {{#if ../../busy}}disabled{{/if}}>{{name}} ({{score}})</button>
                {{else}}
                  <span class="candidate">{{name}} ({{score}})</span>
                {{/if}}
              {{/each}}
            </div>
          {{/each}}
        {{/if}}
      </div>

      {{#if errors.length}}
        <div class="messages errors">
          <h4>{{localize "planestone-importer.patch.errors"}}</h4>
          <ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
        </div>
      {{/if}}

      {{#if changes.length}}
        <div class="patches">
          <h4>{{localize "planestone-importer.patch.changes"}}</h4>
          <ul>{{#each changes}}<li>{{this}}</li>{{/each}}</ul>
        </div>
      {{/if}}

      {{#if warnings.length}}
        <div class="messages warnings">
          <h4>{{localize "planestone-importer.dialog.warnings"}}</h4>
          <ul>{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
        </div>
      {{/if}}

      {{#if isReview}}
        <textarea name="correction" class="correction prose" placeholder="{{localize "planestone-importer.ai.correctionPlaceholder"}}" {{#if busy}}disabled{{/if}}>{{correction}}</textarea>
      {{/if}}
    </div>
    <footer class="buttons">
      {{#if isReview}}
        <button type="button" data-action="prompt" {{#if busy}}disabled{{/if}} data-tooltip="{{localize "planestone-importer.ai.newPromptHint"}}"><i class="fa-solid fa-rotate-left"></i> {{localize "planestone-importer.ai.newPrompt"}}</button>
        <button type="button" data-action="redo" {{#if busy}}disabled{{/if}} data-tooltip="{{localize "planestone-importer.ai.redoHint"}}"><i class="fa-solid fa-rotate"></i> {{localize "planestone-importer.ai.redo"}}</button>
        <button type="button" data-action="correct" {{#if busy}}disabled{{/if}} data-tooltip="{{localize "planestone-importer.ai.correctHint"}}"><i class="fa-solid fa-paper-plane"></i> {{#if busy}}{{localize "planestone-importer.ai.thinking"}}{{else}}{{localize "planestone-importer.ai.correct"}}{{/if}}</button>
        <button type="button" data-action="editYaml" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-code"></i> {{localize "planestone-importer.ai.editYaml"}}</button>
      {{else}}
        <button type="button" data-action="back"><i class="fa-solid fa-rotate-left"></i> {{localize "planestone-importer.dialog.back"}}</button>
      {{/if}}
      <button type="button" data-action="apply" {{#unless canApply}}disabled{{/unless}}><i class="fa-solid fa-file-pen"></i> {{#if applying}}{{localize "planestone-importer.patch.applying"}}{{else}}{{localize "planestone-importer.patch.apply"}}{{/if}}</button>
    </footer>
  {{/if}}

  {{#if isDone}}
    <div class="body">
      <ul class="results">
        <li class="{{#if result.ok}}ok{{else}}failed{{/if}}">
          {{#if result.ok}}<i class="fa-solid fa-check"></i> {{localize "planestone-importer.patch.applied"}}{{else}}<i class="fa-solid fa-xmark"></i> {{result.error}}{{/if}}
        </li>
      </ul>
    </div>
    <footer class="buttons">
      <button type="button" data-action="back"><i class="fa-solid fa-file-pen"></i> {{localize "planestone-importer.patch.another"}}</button>
    </footer>
  {{/if}}
</section>
