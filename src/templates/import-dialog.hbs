<section class="npc-importer">
  {{#if isPick}}
    <div class="body">
      <p class="hint">{{localize "planestone-importer.dialog.hint"}}</p>
      <label class="file-pick">
        <i class="fa-solid fa-file-arrow-up"></i>
        <span>{{#if busy}}{{localize "planestone-importer.dialog.reading"}}{{else}}{{localize "planestone-importer.dialog.choose"}}{{/if}}</span>
        <input type="file" accept=".yaml,.yml,.json" {{#if busy}}disabled{{/if}}>
      </label>
      <p class="or">{{localize "planestone-importer.dialog.orPaste"}}</p>
      <textarea name="sheetText" class="paste" spellcheck="false" placeholder="schemaVersion: 1&#10;kind: actor&#10;meta: { name: …, level: 1 }" {{#if busy}}disabled{{/if}}>{{pasted}}</textarea>
    </div>
    <footer class="buttons">
      <button type="button" data-action="loadText" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-paste"></i> {{localize "planestone-importer.dialog.loadText"}}</button>
    </footer>
  {{/if}}

  {{#if isPreview}}
    <div class="body">
      <h3 class="file-name">{{fileName}}</h3>

      {{#if errors.length}}
        <div class="messages errors">
          <h4>{{localize "planestone-importer.dialog.errors"}}</h4>
          <ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
        </div>
      {{/if}}

      {{#if actors.length}}
        <table class="actors">
          <thead><tr><th>{{localize "planestone-importer.dialog.name"}}</th><th>{{localize "planestone-importer.dialog.level"}}</th><th>{{localize "planestone-importer.dialog.items"}}</th></tr></thead>
          <tbody>
            {{#each actors}}
              <tr><td>{{name}}</td><td>{{level}}</td><td>{{itemCount}}{{#if weaponCount}} ({{weaponCount}} {{localize "planestone-importer.dialog.weapons"}}){{/if}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{/if}}

      {{#if vehicles.length}}
        <table class="actors">
          <thead><tr><th>{{localize "planestone-importer.dialog.vehicle"}}</th><th>{{localize "planestone-importer.dialog.level"}}</th><th>{{localize "planestone-importer.dialog.items"}}</th></tr></thead>
          <tbody>
            {{#each vehicles}}
              <tr><td>{{name}}</td><td>{{level}}</td><td>{{itemCount}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{/if}}

      {{#if items.length}}
        <table class="actors">
          <thead><tr><th>{{localize "planestone-importer.dialog.name"}}</th><th>{{localize "planestone-importer.dialog.type"}}</th></tr></thead>
          <tbody>
            {{#each items}}
              <tr><td>{{name}}</td><td>{{type}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{/if}}

      {{#if warnings.length}}
        <div class="messages warnings">
          <h4>{{localize "planestone-importer.dialog.warnings"}}</h4>
          <ul>{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
        </div>
      {{/if}}
    </div>

    {{#if hasActors}}
      <div class="form-group folder-pick">
        <label for="planestone-importer-folder">{{localize "planestone-importer.dialog.folder"}}</label>
        <select id="planestone-importer-folder" name="folder">
          <option value="">{{localize "planestone-importer.dialog.rootFolder"}}</option>
          {{#each folders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
    {{/if}}

    {{#if items.length}}
      <div class="form-group folder-pick">
        <label for="planestone-importer-item-folder">{{localize "planestone-importer.dialog.itemFolder"}}</label>
        <select id="planestone-importer-item-folder" name="itemFolder">
          <option value="">{{localize "planestone-importer.dialog.itemRootFolder"}}</option>
          {{#each itemFolders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
    {{/if}}

    <footer class="buttons">
      <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> {{localize "planestone-importer.dialog.back"}}</button>
      <button type="button" data-action="import" {{#unless canImport}}disabled{{/unless}}><i class="fa-solid fa-file-import"></i> {{#if busy}}{{localize "planestone-importer.dialog.importing"}}{{else}}{{localize "planestone-importer.dialog.import"}}{{/if}}</button>
    </footer>
  {{/if}}

  {{#if isResults}}
    <div class="body">
      <ul class="results">
        {{#each results}}
          <li class="{{#if ok}}ok{{else}}failed{{/if}}">
            {{#if ok}}<i class="fa-solid fa-check"></i> {{{link}}}{{else}}<i class="fa-solid fa-xmark"></i> {{name}}: {{error}}{{/if}}
          </li>
        {{/each}}
      </ul>
    </div>
    <footer class="buttons">
      <button type="button" data-action="reset"><i class="fa-solid fa-file-import"></i> {{localize "planestone-importer.dialog.another"}}</button>
    </footer>
  {{/if}}
</section>
