{
  "name": "planestone-importer",
  "version": "0.1.0",
  "description": "Imports Planestone sheet files as pf2e NPCs and world items in Foundry VTT",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "dev": "cross-env NODE_ENV=development rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/js-yaml": "^4.0.9",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "rollup": "^4.29.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.83.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
